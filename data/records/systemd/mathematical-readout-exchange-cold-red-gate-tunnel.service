[Unit]
Description=Mathematical Readout Exchange transport to Cold Red Gate
After=network-online.target mathematical-readout-exchange-a2a.service
Wants=network-online.target
Requires=mathematical-readout-exchange-a2a.service

[Service]
Type=simple
ExecStart=/usr/bin/ssh -N -T -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -R 127.0.0.1:8813:127.0.0.1:8813 100.118.93.93
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
