{
  "name": "@emsenn/mathematical-readout-exchange",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Union-facing OSS boundary for qualified executable projections grounded in Obsmetrologia mathematics.",
  "main": "src/contract-cover-nerve-readout.mjs",
  "exports": {
    "./relational-graph": {
      "types": "./types/relational-graph.d.mts",
      "import": "./src/relational-graph.mjs"
    }
  },
  "keywords": [
    "a2a",
    "mathematical-readout",
    "micro-enterprise",
    "lenticule-science"
  ],
  "x-agentic-metro-enterprise": {
    "node-id": "mathematical-readout-exchange",
    "actor": "urn:ame:mathematical-readout-exchange",
    "organizational-kind": "micro-enterprise",
    "owners": [
      "obsmetrological-services-section"
    ],
    "service-level": "union",
    "admission": "an A2A RMN Mark request naming admissible CoverNerve counts, or the exact normalized RMN cover-nerve law carried by an ActivityStreams solicitation with admissible CoverNerve counts",
    "refusal": "invalid input, source drift, cross-settlement mutation, an unqualified equivalence claim, or unsettled pricing authority",
    "implemented-operations": [
      "attest-mathematical-source-bytes",
      "project-cover-nerve-ranks",
      "project-finite-relational-graph-metrology",
      "serve-signed-a2a",
      "serve-activitystreams-contract-over-stdio",
      "issue-provider-local-rwil-receipt-and-causal-evidence",
      "measure-local-resource-use",
      "declare-resource-vector-price-terms"
    ],
    "unimplemented-operations": [
      "formally-verified-Lean-extraction",
      "serve-local-http-json-rpc",
      "ActivityPub-federation",
      "x402-settlement",
      "public-network-deployment"
    ],
    "operation-catalog": {
      "obsmetrologia.coverNerve.rank": {
        "transport": "a2a-1.0-rmn-cbor",
        "accepts": "{ entities: number, cells: number, components: number } — non-negative safe integers satisfying the CoverNerve bounds",
        "returns": "{ h0rank, h1rank, coordinationFree, landauerBits, coordinationCost, cost, certificate }"
      },
      "solicit-service": {
        "contract": "ni:///sha-256;3TCTDawHwIXDnxWPQYzDZc6YhhERQkmO_n9wi06sxlQ",
        "accepts": "ActivityStreams Offer<ServiceSolicitation>",
        "returns": "ActivityStreams Offer|Reject"
      },
      "invoke-service": {
        "contract": "ni:///sha-256;3TCTDawHwIXDnxWPQYzDZc6YhhERQkmO_n9wi06sxlQ",
        "accepts": "ActivityStreams Accept<ServiceContract>",
        "returns": "ActivityStreams Accept|Reject"
      }
    }
  },
  "bin": {
    "serve-mathematical-readout-exchange-a2a": "./bin/serve-a2a.mjs",
    "execute-mathematical-readout-exchange-a2a-task": "./bin/execute-a2a-task.mjs",
    "solicit-service": "./src/contract-cover-nerve-readout.mjs",
    "invoke-service": "./src/contract-cover-nerve-readout.mjs"
  },
  "scripts": {
    "start": "node bin/serve-a2a.mjs",
    "serve:a2a": "node bin/serve-a2a.mjs",
    "test": "node --test test/*.test.mjs",
    "verify": "node src/verify-enterprise.mjs && node --check src/law.mjs && node --check bin/serve-a2a.mjs && node --check bin/execute-a2a-task.mjs && node --check src/contract-cover-nerve-readout.mjs && node --check src/relational-graph.mjs && node --test test/*.test.mjs && lake env lean scripts/Conformance.lean"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.0.0-beta.0",
    "@emsenn/a2a-agent-card-key-service": "file:../../../../../red-cup-engineering/services/web-services-section/services/a2a-services-section/services/a2a-agent-card-key-service",
    "@emsenn/a2a-contracted-agent-service": "file:../../../../../red-cup-engineering/services/web-services-section/services/a2a-services-section/services/a2a-contracted-agent-service",
    "@emsenn/a2a-rmn-part-service": "file:../../../../../red-cup-engineering/services/web-services-section/services/a2a-services-section/services/a2a-rmn-part-service",
    "@emsenn/http-server": "file:../../../../../red-cup-engineering/services/web-services-section/services/http-server",
    "@emsenn/cover-nerve-rank-die": "https://github.com/emsenn/cover-nerve-rank-die/releases/download/v1.0.0/emsenn-cover-nerve-rank-die-1.0.0.tgz",
    "@emsenn/rmn-semantic-conformance-die": "https://github.com/emsenn/rmn-semantic-conformance-die/releases/download/v6.0.0/emsenn-rmn-semantic-conformance-die-6.0.0.tgz",
    "@emsenn/rwil-rdf-services": "file:../rwil-rdf-services"
  },
  "license": "UNLICENSED"
}
