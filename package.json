      "ActivityPub-federation",
      "x402-settlement",
      "public-network-deployment"
    ],
    "operation-catalog": {
      "solicit-service": {
        "contract": "ni:///sha-256;3TCTDawHwIXDnxWPQYzDZc6YhhERQkmO_n9wi06sxlQ",
        "accepts": "ActivityStreams Offer<ServiceSolicitation>",
        "returns": "ActivityStreams Offer|Reject"
      },
      "invoke-service": {
        "contract": "ni:///sha-256;3TCTDawHwIXDnxWPQYzDZc6YhhERQkmO_n9wi06sxlQ",
        "accepts": "ActivityStreams Accept<ServiceContract>",
        "returns": "ActivityStreams Accept|Reject"
      }
    }
  },
  "bin": {
