{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mathematical-readout-exchange",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-07-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
